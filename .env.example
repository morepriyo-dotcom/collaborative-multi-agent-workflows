# ==============================================================================
# FLOWMESH AI — ENVIRONMENT CONFIGURATION
# Track: Collaborative Multi-Agent Workflows
# Required Integrations: Omi + Qdrant + Lyzr
# ==============================================================================

# Lyzr Agent Studio API (Required for live Lyzr Orchestration)
# Sign up at: https://studio.lyzr.ai
LYZR_API_KEY=your_lyzr_api_key_here

# Qdrant Vector Database (Required for persistent memory)
# Cloud: https://cloud.qdrant.io or Local: http://localhost:6333
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=flowmesh_memories

# Omi Wearable / Developer API
# Developer portal: https://omi.me or BasedHardware dev console
OMI_API_KEY=your_omi_api_key_here
OMI_WEBHOOK_SECRET=your_omi_webhook_secret_here

# AI Model Provider (Used for embeddings and fallback orchestration engine)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional OpenAI fallback if preferred
OPENAI_API_KEY=

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
